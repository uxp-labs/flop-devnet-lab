{
 "what": "The devnet test of the chain encoder (D1 and D2) as data: every transaction, who signs it with which tool, what it moves, what the chain should answer and what the lead does if it does not. plan.mjs prints the tables and the command lines of plan.md from it; sign-device.mjs builds the device's calls from it; check.mjs judges the recorded results against it. A $NAME is a value below, DEVICE (the device key's account, from results.json accounts.device.public_key), or $step.Pallet.Event.field (a field of an event recorded for that step).",
 "spec_version": 1014020,
 "files": {
  "rerun": "research/2026-11-12-session-rerun-1014020/results.json",
  "run_log": "research/2026-11-12-session-rerun-1014020/run-log.json",
  "escrow": "research/2026-11-11-session-escrow/results.json",
  "deny": "research/2026-11-11-session-deny-list/results.json",
  "upgrade": "research/2026-11-12-runtime-upgrade/results.json",
  "facts": "research/2026-11-12-session-rerun-1014020/facts-1014020.json"
 },
 "values": {
  "OWNER": { "value": "0xe462d014cab1239a123233647052f4e3b572322e982441d6b7a5c1694d8419e2", "from": { "file": "rerun", "path": "accounts.owner.public_key" }, "same_as": { "file": "deny", "path": "owner.public_key" } },
  "NAMED": { "value": "0x1ec8abdfa88707679f8a2fbfc0bcd80184e2f731d91bb9fa152b750210556c7f", "from": { "file": "deny", "path": "other_account_named.public_key" }, "same_as": { "file": "escrow", "path": "named_miner.public_key" } },
  "PALLET_ACCOUNT": { "value": "0x6d6f646c666c6f702f63686e0000000000000000000000000000000000000000", "from": { "file": "rerun", "path": "steps[5].events[1].fields.to" } },
  "SPEC_NAME": { "value": "tzkv-runtime", "from": { "file": "upgrade", "path": "spec_name" } },
  "SPEC": { "value": "1014020", "from": { "file": "facts", "path": "spec_version" } },
  "TXV": { "value": "2", "from": { "file": "upgrade", "path": "transaction_version.after" } },
  "GENESIS": { "value": "0x99c172c095340ace980631f9123544c6bebd4839f3437e463533422d8be2d631", "from": { "file": "upgrade", "path": "genesis" } },
  "RPC": { "value": "wss://rpc.devnet.flop.network", "from": { "file": "upgrade", "path": "rpc" } },
  "EVENTS_KEY": { "value": "0x26aa394eea5630e07c48ae0c9558cef780d41e5e16056765bc8461851072c9d7", "from": { "file": "upgrade", "path": "keys[\"System.Events\"]" } },
  "OWNER_NONCE_AFTER_RERUN": { "value": "14", "from": { "file": "run_log", "path": "next_nonce.owner" } },
  "MAX_FEE": { "value": "10558485985000000", "from": { "file": "rerun", "path": "steps[2].fee_raw" } },
  "FUND": { "value": "150000000000000000", "from": { "file": "escrow", "path": "steps[0].what", "re": "send (\\d+) raw" } },
  "A_CAP": { "value": "50000000000000000", "from": { "file": "escrow", "path": "session.spending_cap_raw" } },
  "A_PER_TX": { "value": "20000000000000000", "from": { "file": "escrow", "path": "session.per_tx_limit_raw" } },
  "A_DAILY": { "value": "25000000000000000", "from": { "file": "escrow", "path": "session.daily_cap_raw" } },
  "A_BLOCKS": { "value": "7200", "from": { "file": "escrow", "path": "session.duration_blocks" } },
  "A_ALLOW": { "value": "ComputeChannel", "from": { "file": "escrow", "path": "session.allowed_pallets" } },
  "ESCROW_1": { "value": "10000000000000000", "from": { "file": "escrow", "path": "channel.record_after_step_4.escrow_raw" } },
  "TOP_UP": { "value": "1000000000000000", "computed": { "div": ["ESCROW_1", "10"] }, "why": "the brief: a tenth of the escrow" },
  "MODEL": { "value": "0x1a52c1abe781db051e70ae357f72bb70161ca0c092df0b618f22a9292ba63306", "from": { "file": "escrow", "path": "force_open.model_hash" } },
  "ROOT": { "value": "0x1a52c1abe781db051e70ae357f72bb70161ca0c092df0b618f22a9292ba63306", "from": { "file": "escrow", "path": "force_open.measured_root" } },
  "POLICY": { "value": "0xeca6a3f9c5a9fa1556892182ffef15b1273c075146a2d1a87814ae83ecea3053", "from": { "file": "escrow", "path": "force_open.decode_policy_hash" } },
  "PRECISION": { "value": "BF16", "from": { "file": "escrow", "path": "force_open.precision" } },
  "MAX_TURNS": { "value": "1024", "from": { "file": "escrow", "path": "force_open.sla.max_turns" } },
  "MAX_DURATION": { "value": "1200", "from": { "file": "escrow", "path": "force_open.sla.max_duration" } },
  "REATTEST": { "value": "1", "from": { "file": "escrow", "path": "force_open.sla.reattest_every" } },
  "ACK_WINDOW": { "value": "600", "from": { "file": "facts", "path": "constants.ComputeChannel.AckWindow.value" } },
  "MIN_FAILED_ACK": { "value": "50000000000000000", "from": { "file": "facts", "path": "constants.ComputeChannel.MinForceOpenEscrowForFailedAck.value" } },
  "MAX_UNCONSENTED": { "value": "14400", "from": { "file": "facts", "path": "constants.ComputeChannel.MaxUnconsentedSessionBlocks.value" } },
  "MAX_SETTLEMENT_TURNS": { "value": "1024", "from": { "file": "facts", "path": "constants.ComputeChannel.MaxSettlementTurns.value" } },
  "MAX_DURATION_D2": { "value": "120", "decided": "short, so T7 can be sent soon after T6: below the ack window, so the channel of T5 has timed out by the time T6 may be sent. No lower bound is stated in the 1014020 metadata (no constant and no error names one); the upper bound for an open the miner did not sign is MAX_UNCONSENTED" },
  "ENCLAVE_KEY": { "value": "0x696d642d666c6f702d64322d656e636c6176652d6b65792d3230323631313132", "decided": "32 bytes of the lab's own choosing: the ASCII text imd-flop-d2-enclave-key-20261112. The pallet does not verify TEE provenance for the key (the doc comment of open_channel)" },
  "SETTLEMENT": { "value": "Standard", "decided": "the plain class: CertificatePremium needs INT8 exact serving and a weight commitment (errors PremiumRequiresInt8Exact, PremiumRequiresWeightCommitment)" },
  "N_T3": { "value": "7320261113000001", "decided": "a new channel nonce: the earlier tests' channels stay on chain, and a channel id that exists fails with ChannelExists" },
  "N_T5": { "value": "7320261113000002", "decided": "a second new channel nonce, for the channel of T5, for the same reason as N_T3" }
 },
 "fund_rule": { "transactions_of_the_device": ["T3", "T4", "T5", "T6", "T7", "T9"], "fee_each": "MAX_FEE", "margin_times": 2,
   "why": "FUND must cover every device transaction at the rerun's largest recorded fee, twice over: the fees of T4 and T5 are not known, and open_channel is 33 bytes longer than force_open. The rerun's FUND is used again rather than a new sum" },
 "steps": [
  { "id": "T1", "signer": "owner", "tool": "research-signer", "nonce": 0, "call": ["transfer", "--to", "$DEVICE", "--amount", "$FUND"],
    "declared": null, "moves": [{ "from": "owner", "to": "device", "amount": "$FUND", "comes_back": "at T9, less the device's fees" }],
    "expect": "success", "events": [{ "event": "Balances.Transfer", "fields": { "from": "$OWNER", "to": "$DEVICE", "amount": "$FUND" } }],
    "fee_like": "A1", "on_unexpected": "stop", "cleanup": false, "shows": "the device has its fees" },
  { "id": "T2", "signer": "owner", "tool": "research-signer", "nonce": 1, "call": ["create-session", "--delegate", "$DEVICE", "--cap", "$A_CAP", "--per-tx", "$A_PER_TX", "--daily", "$A_DAILY", "--blocks", "$A_BLOCKS", "--allow", "$A_ALLOW"],
    "declared": null, "moves": [],
    "expect": "success", "events": [{ "event": "FlopSessionKeys.SessionCreated", "fields": { "owner": "$OWNER", "delegate": "$DEVICE", "spending_cap": "$A_CAP", "per_tx_limit": "$A_PER_TX", "daily_cap": "$A_DAILY" } }],
    "forbid": ["Balances.Reserved", "Balances.Held"], "fee_like": "A2", "on_unexpected": "stop", "cleanup": false, "shows": "the session of the rerun's session A, for the new device" },
  { "id": "T3", "signer": "device", "tool": "encoder",
    "inner": { "call": "force_open", "miner": "$NAMED", "model_hash": "$MODEL", "measured_root": "$ROOT", "decode_policy_hash": "$POLICY", "precision": "$PRECISION", "agent_key": "$DEVICE",
      "sla": { "max_turns": "$MAX_TURNS", "max_duration": "$MAX_DURATION", "reattest_every": "$REATTEST" }, "escrow": "$ESCROW_1", "nonce": "$N_T3" },
    "declared": "$ESCROW_1", "moves": [{ "from": "owner", "to": "pallet", "amount": "$ESCROW_1", "comes_back": "at T6, after the ack window" }],
    "expect": "success", "events": [
     { "event": "Balances.Transfer", "fields": { "from": "$OWNER", "to": "$PALLET_ACCOUNT", "amount": "$ESCROW_1" } },
     { "event": "ComputeChannel.ForceOpenRequested", "fields": { "agent": "$OWNER", "miner": "$NAMED", "escrow": "$ESCROW_1" } },
     { "event": "FlopSessionKeys.SessionCallExecuted", "fields": { "owner": "$OWNER", "delegate": "$DEVICE", "spent": "$ESCROW_1" } }],
    "ack_deadline_within": "$ACK_WINDOW", "finding_if": { "FlopSessionKeys.SpendExceedsDeclared": "the encoder's rule E5 (the declared spend is the escrow) does not hold on chain" },
    "fee_like": "A6", "on_unexpected": "stop", "cleanup": false, "shows": "a mortal era signed by the lab, and a declared spend exactly equal to the escrow" },
  { "id": "T4", "signer": "device", "tool": "encoder",
    "inner": { "call": "top_up_escrow", "channel_id": "$T3.ComputeChannel.ForceOpenRequested.channel_id", "additional": "$TOP_UP" },
    "declared": "$TOP_UP", "moves": [{ "from": "owner", "to": "pallet", "amount": "$TOP_UP", "comes_back": "at T6 with the escrow, if it moved" }],
    "expect": "recorded", "errors_allowed_of": ["ComputeChannel", "FlopSessionKeys"],
    "events_if_success": [
     { "event": "ComputeChannel.EscrowToppedUp", "fields": { "channel_id": "$T3.ComputeChannel.ForceOpenRequested.channel_id", "added": "$TOP_UP" } },
     { "event": "FlopSessionKeys.SessionCallExecuted", "fields": { "owner": "$OWNER", "delegate": "$DEVICE" } }],
    "fee_like": null, "on_unexpected": "stop", "cleanup": false, "shows": "the chain reads the encoder's layout of top_up_escrow: the call is included and named by its outcome" },
  { "id": "T5", "signer": "device", "tool": "encoder",
    "inner": { "call": "open_channel", "miner": "$NAMED", "model_hash": "$MODEL", "measured_root": "$ROOT", "decode_policy_hash": "$POLICY", "precision": "$PRECISION", "enclave_key": "$ENCLAVE_KEY", "agent_key": "$DEVICE",
      "sla": { "max_turns": "$MAX_TURNS", "max_duration": "$MAX_DURATION_D2", "reattest_every": "$REATTEST" }, "escrow": "$ESCROW_1", "nonce": "$N_T5", "settlement_class": "$SETTLEMENT" },
    "declared": "$ESCROW_1", "moves": [{ "from": "owner", "to": "pallet", "amount": "$ESCROW_1", "comes_back": "at T7, after max_duration, if it moved" }],
    "expect": "recorded", "errors_allowed_of": ["ComputeChannel", "FlopSessionKeys"],
    "events_if_success": [
     { "event": "ComputeChannel.ChannelOpened", "fields": { "agent": "$OWNER", "miner": "$NAMED", "escrow": "$ESCROW_1" } },
     { "event": "FlopSessionKeys.SessionCallExecuted", "fields": { "owner": "$OWNER", "delegate": "$DEVICE" } }],
    "fee_like": null, "on_unexpected": "stop", "cleanup": false, "shows": "D2: the chain reads the encoder's layout of open_channel" },
  { "id": "T6", "signer": "device", "tool": "encoder",
    "inner": { "call": "expire_force_open", "channel_id": "$T3.ComputeChannel.ForceOpenRequested.channel_id" },
    "only_if": { "step": "T3", "event": "ComputeChannel.ForceOpenRequested" },
    "after_block": { "event": "$T3.ComputeChannel.ForceOpenRequested.ack_deadline" },
    "declared": "0", "moves": [
     { "from": "pallet", "to": "owner", "amount": "$ESCROW_1", "comes_back": "this is the return of T3" },
     { "from": "pallet", "to": "owner", "amount": "$TOP_UP", "when": { "step": "T4", "outcome": "success" }, "comes_back": "this is the return of T4" }],
    "refund_event": "ComputeChannel.ForceOpenExpired.refunded",
    "expect": "success", "events": [
     { "event": "ComputeChannel.ForceOpenExpired", "fields": { "channel_id": "$T3.ComputeChannel.ForceOpenRequested.channel_id", "miner": "$NAMED", "failed_acks": "0" } },
     { "event": "FlopSessionKeys.SessionCallExecuted", "fields": { "owner": "$OWNER", "delegate": "$DEVICE" } }],
    "fee_like": "A9", "on_unexpected": "stop", "cleanup": true, "shows": "the escrow of T3 comes back" },
  { "id": "T7", "signer": "device", "tool": "encoder",
    "inner": { "call": "timeout", "channel_id": "$T5.ComputeChannel.ChannelOpened.channel_id" },
    "only_if": { "step": "T5", "event": "ComputeChannel.ChannelOpened" },
    "after_block": { "step": "T5", "plus": "$MAX_DURATION_D2" },
    "declared": "0", "moves": [{ "from": "pallet", "to": "owner", "amount": "$ESCROW_1", "comes_back": "this is the return of T5" }],
    "refund_event": "ComputeChannel.TimedOutRefunded.refunded",
    "expect": "success", "events": [
     { "event": "ComputeChannel.TimedOutRefunded", "fields": { "channel_id": "$T5.ComputeChannel.ChannelOpened.channel_id" } },
     { "event": "FlopSessionKeys.SessionCallExecuted", "fields": { "owner": "$OWNER", "delegate": "$DEVICE" } }],
    "fee_like": "A3", "on_unexpected": "stop", "cleanup": true, "shows": "the escrow of T5 comes back" },
  { "id": "T8", "signer": "owner", "tool": "research-signer", "nonce": 2, "call": ["revoke", "--delegate", "$DEVICE"],
    "declared": null, "moves": [],
    "expect": "success", "events": [{ "event": "FlopSessionKeys.SessionRevoked", "fields": { "owner": "$OWNER", "delegate": "$DEVICE" } }],
    "only_if": { "step": "T2", "outcome": "success" },
    "fee_like": "A10", "on_unexpected": "stop", "cleanup": true, "shows": "the session is ended" },
  { "id": "T9", "signer": "device", "tool": "research-signer", "call": ["sweep", "--to", "$OWNER"],
    "declared": null, "moves": [{ "from": "device", "to": "owner", "amount": "rest", "comes_back": "this is the return of T1, less the device's fees" }],
    "expect": "success", "events": [{ "event": "System.KilledAccount", "fields": { "account": "$DEVICE" } }, { "event": "Balances.Transfer", "fields": { "from": "$DEVICE", "to": "$OWNER" } }],
    "only_if": { "step": "T1", "outcome": "success" },
    "fee_like": "A11", "on_unexpected": "stop", "cleanup": true, "shows": "nothing is left on the device" }
 ]
}
