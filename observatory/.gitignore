# Anchored to this folder, so a folder of the same name deeper down (test/out/, say) is never
# ignored: a file there would run as a test while git and the report's dirty list could not see it.
/node_modules/
/dist/
/out/
# Each `npm run check` writes a new evidence directory here. Kept local and uploaded by CI, never committed.
/check-runs/
# Private builds that builders make for command line repros. Never committed.
/.build-*/
