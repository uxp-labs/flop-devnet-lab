{
  "name": "flop-observatory",
  "version": "0.0.1",
  "private": true,
  "description": "Read-only observatory for FLOP devnet: status, reset detection, spec drift, census and finalized escrow checks. M0 runs on saved fixtures only.",
  "type": "module",
  "bin": {
    "flop-observatory": "./dist/cli.js",
    "flop-observatory-mcp": "./dist/mcp-bin.js"
  },
  "exports": {
    "./scale/block": {
      "types": "./dist/scale/block.d.ts",
      "default": "./dist/scale/block.js"
    },
    "./shapes/*.json": "./shapes/*.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "check": "bash ./scripts/check.sh"
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@polkadot-api/metadata-builders": "0.15.2",
    "@polkadot-api/substrate-bindings": "0.21.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
