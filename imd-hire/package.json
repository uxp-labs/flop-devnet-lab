{
  "name": "imd-hire",
  "version": "0.0.1",
  "private": true,
  "description": "Offline signer for hiring the IMD swarm: turns a quote and its 402 challenge into the two wallet signatures IMD asks for. Never touches the network.",
  "type": "module",
  "bin": {
    "imd-hire": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "viem": "^2.57.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
