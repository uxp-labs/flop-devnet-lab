{
  "name": "imd-flop",
  "version": "0.0.1",
  "private": true,
  "description": "Reference companion CLI for the 'FLOP, by choice' IMD worker proposal (devnet rehearsal, mock provider by default)",
  "type": "module",
  "bin": {
    "imd-flop": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node scripts/need-observatory.mjs",
    "build": "tsc -p tsconfig.json",
    "pretest": "node scripts/need-observatory.mjs",
    "test": "tsc -p tsconfig.json && vitest run",
    "check": "bash ./scripts/offline-check.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "bash ./demo.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@flop-labs/client": "^0.2.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/sr25519": "2.4.0",
    "flop-observatory": "file:../observatory",
    "viem": "^2.57.17"
  },
  "devDependencies": {
    "@polkadot-api/metadata-builders": "0.15.2",
    "@polkadot-api/substrate-bindings": "0.21.2",
    "@polkadot/util": "14.0.3",
    "@polkadot/wasm-crypto": "7.5.4",
    "@polkadot/x-randomvalues": "14.0.3",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
